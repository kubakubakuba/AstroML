[Unit]
Description=AstroML companion (camera over USB, page on the AstroML hotspot)
After=network-online.target
Wants=network-online.target

[Service]
User=astroml
Group=astroml
SupplementaryGroups=plugdev dialout gpio
# Port 80 without root: captive portals only probe plain HTTP on port 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
StateDirectory=astroml-companion
# Choose the mount here: --mount ioptron --serial /dev/ttyUSB0 (CEM60),
# or --mount st4 --st4-axes ra --guide-rate 0.5 (SkyGuider on the ST-4 board).
ExecStart=/opt/astroml-companion/venv/bin/astroml-companion run --port 80 --portal-host 10.42.0.1 --state-dir /var/lib/astroml-companion --mount none
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
